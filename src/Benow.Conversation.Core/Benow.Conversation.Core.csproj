<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Phase 3 complete (docs/plans/conversation-v2.md in the nastv repo): + personas, settings
         host, streaming capture, TurnTimeline, the fixed VAD (pre-roll), pipelined speech queue.
         0.5.0 adds the IAudioOut playback seam so NASTV can host the same speech queue with a SignalR sink (plan §4.5, "no duplicated functionality"). Tags drive CI publishes. -->
    <Version>0.5.3</Version>
    <PackageId>Benow.Conversation.Core</PackageId>
    <Authors>benow</Authors>
    <Description>Shared conversation engine core: voice pipeline (VAD, segment dispatch, progressive TTS), AI providers (STT/LLM/TTS), LLM strategy, capture, and configuration. Consumed by the Conversation desktop app and NASTV.</Description>
    <PackageProjectUrl>https://github.com/benow/conversation</PackageProjectUrl>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/benow/conversation</RepositoryUrl>
    <!-- Dependency ceiling per the V2 plan §4.2: no ASP.NET, no DB drivers, no SDK refs —
         must stay loadable inside NASTV's plugin zip (deps.json-free base-dir probing). -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Benow.Conversation.Core.Tests" />
    <None Include="PACKAGE.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
